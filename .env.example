# ============================================================
# SALON TEMPLATE — .env checklist
# Copy this file to .env and fill in every value marked [CHANGE]
# Then run: php artisan key:generate && php artisan storage:link && php artisan migrate:fresh --seed
# Railway: set RUN_SEED=true (no SEED_CLASS) — runs DatabaseSeeder (FreshInstall + ServicesFixture)
# ============================================================

# ---- App -------------------------------------------------------
APP_NAME=Laravel                          # [CHANGE] e.g. "صالون كاراميلا"
APP_ENV=production                        # local | production
APP_KEY=                                  # filled by: php artisan key:generate
APP_DEBUG=false                           # set true only in local
APP_URL=https://your-salon-domain.com     # [CHANGE]

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

# ---- Salon identity (read by FreshInstallSeeder) ---------------
SALON_NAME="اسم الصالون"                  # [CHANGE] shown in UI and emails
SALON_COUNTRY=SA                          # SA | AE | EG — controls currency symbol
ADMIN_NAME="مدير الصالون"                 # [CHANGE]
ADMIN_EMAIL=admin@example.com             # [CHANGE]
ADMIN_PASSWORD=ChangeMe123!               # [CHANGE] strong password
OWNER_NAME="صاحب الصالون"                 # [CHANGE]
OWNER_EMAIL=owner@salon.test              # [CHANGE]
OWNER_PASSWORD=ChangeMe123!               # [CHANGE] strong password

# ---- Database --------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1                         # [CHANGE] if using cloud DB
DB_PORT=3306
DB_DATABASE=salon                         # [CHANGE] one DB per salon
DB_USERNAME=root                          # [CHANGE]
DB_PASSWORD=                              # [CHANGE]

# ---- Mail ------------------------------------------------------
MAIL_MAILER=smtp                          # log (dev) | smtp (prod)
MAIL_SCHEME=null
MAIL_HOST=smtp.mailprovider.com           # [CHANGE]
MAIL_PORT=587                             # [CHANGE]
MAIL_USERNAME=null                        # [CHANGE]
MAIL_PASSWORD=null                        # [CHANGE]
MAIL_FROM_ADDRESS="noreply@example.com"   # [CHANGE]
MAIL_FROM_NAME="${APP_NAME}"

# ---- Storage ---------------------------------------------------
# local dev: public (local disk)
# production (Railway/Render/cloud): s3  ← MUST use s3 or files are lost on every deploy
FILESYSTEM_DISK=public

# Supabase Storage (S3-compatible) — required in production to persist images/videos/logo
# Setup steps:
#   1. Go to supabase.com → your project → Storage → Create bucket (e.g. "salon-assets")
#   2. Make the bucket PUBLIC (toggle on)
#   3. Go to Settings → Storage → S3 Access Keys → Generate new key
#   4. Fill in the values below, then set FILESYSTEM_DISK=s3 in production env vars
#
# AWS_URL  = public base URL → https://<project-ref>.supabase.co/storage/v1/object/public/<bucket-name>
# AWS_ENDPOINT = S3 API URL  → https://<project-ref>.supabase.co/storage/v1/s3
#
AWS_ACCESS_KEY_ID=                        # [CHANGE] from Supabase S3 Access Keys
AWS_SECRET_ACCESS_KEY=                    # [CHANGE] from Supabase S3 Access Keys
AWS_DEFAULT_REGION=auto                   # keep "auto" for Supabase
AWS_BUCKET=salon-assets                   # [CHANGE] your bucket name in Supabase
AWS_URL=                                  # [CHANGE] https://<ref>.supabase.co/storage/v1/object/public/<bucket>
AWS_ENDPOINT=                             # [CHANGE] https://<ref>.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true          # required for Supabase

# ---- Cache / Queue / Session -----------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ---- Misc ------------------------------------------------------
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
APP_MAINTENANCE_DRIVER=file
BROADCAST_CONNECTION=log
VITE_APP_NAME="${APP_NAME}"
